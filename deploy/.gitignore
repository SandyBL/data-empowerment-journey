node_modules/
.netlify/assets/

# Build output. `npm run build` (scripts/generate-blog-index.mjs) writes these
# in place, and Netlify publishes the repository directory itself, so every one
# of them is regenerated on every deploy. Committing them meant two copies of
# the same page — the generator's and the repository's — and nothing forced the
# two to agree: a change to src/home.html or to an article's Markdown showed up
# in the deploy while the committed copy stayed as it was, so a reviewer reading
# the repository was reading a page the site no longer served. The generator is
# the single source of truth. A failing build now fails the deploy outright
# instead of quietly shipping a stale copy, which is the behaviour we want.
#
# What is NOT here, and must stay tracked: the three <lang>/blog/index.html
# files, which are hand-maintained pages the build only edits between markers;
# 404.html, thank-you.html and robots.txt, which nothing generates; and
# everything under src/, admin/ and simulators/.
/index.html
/en/index.html
/pt/index.html
/en/confession-wall/
/es/confession-wall/
/pt/confession-wall/
/en/blog/*/
/es/blog/*/
/pt/blog/*/
# (the three patterns above also cover <lang>/blog/category/, the category hubs)

# The standalone pages and the glossary, generated from content/pages/ and
# content/glossary/ by writeSitePages and writeGlossary. These were tracked and
# the rest of the build output was not, which is how the repository came to hold
# forty-six copies of a page whose <head> the generator had since rewritten --
# every one of them still loading Font Awesome from a CDN the site no longer
# uses. Listed by their localized addresses, which is what the generator writes:
# see PAGE_SLUGS in scripts/lib/routes.mjs.
/en/about/
/en/advisory-sessions/
/en/calculator/
/en/consulting/
/en/faq/
/en/glossary/
/en/maturity-assessment/
/en/playbooks/
/en/resources/
/en/simulator-results/
/en/templates/
/en/workshops/
/es/sobre-mi/
/es/sesiones-de-asesoria/
/es/calculadora/
/es/consultoria/
/es/preguntas-frecuentes/
/es/glosario/
/es/diagnostico-de-madurez/
/es/playbooks/
/es/recursos/
/es/resultados-de-simuladores/
/es/plantillas/
/es/talleres/
/pt/sobre/
/pt/sessoes-de-assessoria/
/pt/calculadora/
/pt/consultoria/
/pt/perguntas-frequentes/
/pt/glossario/
/pt/diagnostico-de-maturidade/
/pt/playbooks/
/pt/recursos/
/pt/resultados-dos-simuladores/
/pt/modelos/
/pt/workshops/
# The three feeds, written by renderFeeds from the same article list.
/en/feed.xml
/es/feed.xml
/pt/feed.xml
/llms.txt
/llms-full.txt
/sitemap.xml
/_redirects
# Written only by a non-production build (see renderHeaders): it carries the
# site-wide noindex that keeps deploy previews and branch deploys out of search.
/_headers
/assets/search/
# The standard simulator wording, lifted out of the nine pages by
# scripts/extract-simulator-text.mjs so the admin console has something to show
# an operator next to their rewrite. A read-only copy of text that lives in those
# pages: committing it would be a second version of every scenario with nothing
# forcing the two to agree.
/assets/data/
